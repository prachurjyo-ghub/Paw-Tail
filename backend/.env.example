# Core runtime
NODE_ENV=
PORT=
MONGODB_URI=

# Authentication
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

# Exact frontend origins (no paths)
CLIENT_URL=
ADMIN_URL=
# Optional comma-separated additional origins; leave empty in production unless explicitly required
CLIENT_URLS=

# Email delivery
MAIL_DELIVERY_ENABLED=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=

# Explicit manual local-media migration only
MEDIA_MIGRATION_ENABLED=
MEDIA_MIGRATION_ALLOW_PRODUCTION=

# Explicit one-time administrator bootstrap (used only by npm run bootstrap:admin)
BOOTSTRAP_ADMIN_ENABLED=
BOOTSTRAP_ADMIN_ALLOW_PRODUCTION=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
